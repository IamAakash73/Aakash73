class Solution {
    int fn(int i, string &s, vector<int>& dp) {
        int n = s.length();

        if (i == n) return 1;
        if (s[i] == '0') return 0;

        if (dp[i] != -1) return dp[i];

        int one = fn(i + 1, s, dp);

        int two = 0;
        if (i + 1 < n && stoi(s.substr(i, 2)) <= 26) {
            two = fn(i + 2, s, dp);
        }

        return dp[i] = one + two;
    }

public:
    int numDecodings(string s) {
        int n = s.length();
        vector<int> dp(n, -1);

        return fn(0, s, dp);
    }
};
