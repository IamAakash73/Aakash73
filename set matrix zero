class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {
        int m = matrix.size();
        int n = matrix[0].size();
        bool col0 = false;

        // mark ist row and ist col
        for(int i = 0; i<m; i++){            // O(m.n)
            if(matrix[i][0] ==0) col0= true;
            for(int j = 1; j<n; j++){
                if(matrix[i][j] ==0){
                    matrix[i][0]=0;
                    matrix[0][j] =0;
                }
            }
        } 
        //inner matrixes    //O(m-1 * n-1) ~ m*n
        for(int i = 1; i<m; i++){
            for(int j = 1; j<n; j++){
                if(matrix[i][0] ==0 || matrix[0][j] ==0){
                    matrix[i][j] =0;
                }
            }
        }
        //ist row if need   // O(n)
        if(matrix[0][0] ==0){
            for(int j = 0; j<n; j++){
                matrix[0][j] =0;
            }
        }
        // first col if need  // O(m)
        if(col0==true){
            for(int i = 0; i<m; i++){
                matrix[i][0] =0;

            }
        }
    }
};
// total tc = O(m.n)
// sc = O(1)
